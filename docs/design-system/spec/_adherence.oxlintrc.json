{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/content/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|outline-on-dark|ghost|disabled)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'outline-on-dark' | 'ghost' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|badge|image|imageNode|icon|title|description|action|cornerSquare|cornerPosition|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, badge, image, imageNode, icon, title, description, action, cornerSquare, cornerPosition, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:product|feature|resource)$/]",
        "message": "<Card> variant must be one of 'product' | 'feature' | 'resource'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='cornerPosition'] > Literal[value!=/^(?:top-left|top-right|bottom-left|bottom-right)$/]",
        "message": "<Card> cornerPosition must be one of 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerSquare'] > JSXAttribute > JSXIdentifier[name!=/^(?:position|size|color|key|ref|className|style|children)$/]",
        "message": "<CornerSquare> doesn't accept that prop. Declared props: position, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerSquare'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top-left|top-right|bottom-left|bottom-right)$/]",
        "message": "<CornerSquare> position must be one of 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|cta|onClick|key|ref|className|style|children)$/]",
        "message": "<CtaStrip> doesn't accept that prop. Declared props: headline, cta, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: heading, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroChapter'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|subhead|image|primaryCta|secondaryCta|onPrimary|onSecondary|cornerSquare|key|ref|className|style|children)$/]",
        "message": "<HeroChapter> doesn't accept that prop. Declared props: eyebrow, headline, subhead, image, primaryCta, secondaryCta, onPrimary, onSecondary, cornerSquare."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|key|ref|className|style|children)$/]",
        "message": "<PillTab> doesn't accept that prop. Declared props: active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|activeLink|cta|onNavigate|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: brand, links, activeLink, cta, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|caption|cornerSquare|bordered|key|ref|className|style|children)$/]",
        "message": "<StatCallout> doesn't accept that prop. Declared props: value, caption, cornerSquare, bordered."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: items, active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: items."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
